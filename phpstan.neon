includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max

    paths:
        - app
        - database
        - routes
        - config

    # Every one of these would be a legitimate finding elsewhere; here they are
    # noise from Eloquent's dynamic surface, and each is listed individually
    # rather than silenced with a blanket ignore.
    ignoreErrors:
        # Larastan infers `definition()` as returning the model's own property
        # names, a type that cannot be written in a docblock — the phpdoc parser
        # rejects `array<model property of X, mixed>`. So the only way to satisfy
        # it is to say nothing, and the only way to keep level max is to name the
        # exception here. Every factory in the project hits it identically.
        - identifier: method.childReturnType
          path: database/factories/*

    checkModelProperties: true
    checkOctaneCompatibility: true

    # No baseline file, on purpose. A baseline is a promise to fix things later
    # that nobody keeps; this project starts at level max and stays there.
