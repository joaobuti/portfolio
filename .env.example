APP_NAME="Portfolio Billing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_PORT=8000
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=UTC

# Hosted link payments. Keep fake until merchant configuration is supplied.
BILLING_GATEWAY=fake
# Required only with BILLING_GATEWAY=infinitepay. Keep secrets server-side.
# API key enables single_payment and expiry; handle excludes the $ prefix.
INFINITEPAY_HANDLE=
INFINITEPAY_API_KEY=
# Public HTTPS tunnel address for local callbacks; see docs/OPERATIONS.md.
# Append /api/v1/webhooks/infinitepay; localhost is the tunnel origin only.
INFINITEPAY_WEBHOOK_URL=
INFINITEPAY_REDIRECT_URL=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_ACTIVITY_RETENTION_DAYS=90

# Postgres, not MySQL: real check constraints, partial indexes (used to enforce
# "one access-granting subscription per customer"), and proper timestamptz.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=billing
DB_USERNAME=billing
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis does three distinct jobs here — queue, cache and distributed lock.
# See docs/adr/0003-redis-for-queue-cache-and-locks.md.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Sanctum bearer tokens. The expiration is set deliberately: Sanctum's own
# default is null, meaning a leaked token is valid forever. Twelve hours forces
# integrations to refresh and bounds the damage of a token in a log file.
# See docs/adr/0006-sanctum-tokens-abilities-and-ownership.md.
AUTH_GUARD=sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:8000,127.0.0.1:8000
# Set true for an HTTPS deployment. Browser credentials stay HttpOnly.
SESSION_SECURE_COOKIE=false
DEMO_ENABLED=false
DEMO_TTL_MINUTES=60
DEMO_MAX_WORKSPACES=100
SANCTUM_EXPIRATION=720
SANCTUM_TOKEN_PREFIX=

# The Node pricing service owns regional tax and coupon rules. It is called
# synchronously during a plan change; if it cannot be reached the quote comes
# back degraded (untaxed, flagged) rather than failing the request.
# See docs/adr/0005-synchronous-pricing-with-a-degraded-fallback.md.
PRICING_SERVICE_ENABLED=true
PRICING_SERVICE_URL=http://pricing:3000
PRICING_SERVICE_TIMEOUT=2.0
PRICING_SERVICE_CONNECT_TIMEOUT=1.0
PRICING_BREAKER_THRESHOLD=5
PRICING_BREAKER_OPEN_SECONDS=30
PRICING_DEFAULT_REGION=BR

MAIL_MAILER=log
MAIL_FROM_ADDRESS="billing@example.test"
MAIL_FROM_NAME="${APP_NAME}"
